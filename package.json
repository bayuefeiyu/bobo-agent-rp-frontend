{
  "name": "bobo-agent-rp-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent official frontend redesign workspace; public contracts, SDK, neutral harness and handoff.",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node tools/dev-server.mjs",
    "dev:launcher": "node tools/dev-server.mjs --service=launcher --port=4318",
    "build": "node tools/build.mjs",
    "preview": "node tools/dev-server.mjs --built --port=4319",
    "test": "node --test test/*.test.mjs",
    "check": "node tools/check.mjs",
    "verify": "npm run check && npm test && npm run build",
    "contract:inventory": "node tools/contract-inventory.mjs"
  }
}
